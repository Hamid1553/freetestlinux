name: Ubuntu Desktop Cloud RDP

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:

      - name: 1. Enable Remote Desktop & Firewall
        run: |
          sudo apt update
          sudo apt install -y xfce4 xfce4-goodies xrdp xorgxrdp dbus-x11
          sudo adduser xrdp ssl-cert || true
          sudo systemctl enable xrdp
          sudo systemctl restart xrdp

      - name: 2. Create Admin Account
        run: |
          # --- TEMP fixed password for debugging (remove after testing) ---
          RDP_PASSWORD="121213Hh+"
          echo "::add-mask::$RDP_PASSWORD"
          echo "RDP_PASSWORD=$RDP_PASSWORD" >> $GITHUB_ENV

          # Create the Linux user (delete first if it exists, so state is clean)
          sudo userdel -r NvDAdmin 2>/dev/null || true
          sudo useradd -m -s /bin/bash NvDAdmin

          # Set the password — use chpasswd correctly and verify it
          echo "NvDAdmin:${RDP_PASSWORD}" | sudo chpasswd
          echo "Password set. Verifying account status:"
          sudo passwd -S NvDAdmin

          sudo usermod -aG sudo NvDAdmin
          sudo usermod -aG ssl-cert NvDAdmin

          # Allow NvDAdmin to sudo without a password prompt (optional but avoids lockout)
          echo "NvDAdmin ALL=(ALL) NOPASSWD:ALL" | sudo tee /etc/sudoers.d/nvdadmin

          # Configure XFCE session
          echo "xfce4-session" | sudo tee /home/NvDAdmin/.xsession
          sudo chown NvDAdmin:NvDAdmin /home/NvDAdmin/.xsession
          sudo chmod +x /home/NvDAdmin/.xsession

          # Configure xRDP startup
          sudo bash -c 'cat > /etc/xrdp/startwm.sh << "EOF"
          #!/bin/sh
          if [ -r /etc/profile ]; then
              . /etc/profile
          fi

          if [ -r "$HOME/.profile" ]; then
              . "$HOME/.profile"
          fi

          export XDG_CURRENT_DESKTOP=XFCE
          export XDG_SESSION_DESKTOP=xfce
          export XDG_CONFIG_DIRS=/etc/xdg/xdg-xfce:/etc/xdg
          export XDG_DATA_DIRS=/usr/share/xfce4:/usr/local/share:/usr/share

          exec startxfce4
          EOF'

          sudo chmod +x /etc/xrdp/startwm.sh

          # Make sure PAM allows this user (some runner images restrict login shells)
          sudo chsh -s /bin/bash NvDAdmin

          sudo systemctl restart xrdp
          sudo systemctl status xrdp --no-pager

      - name: 3. Install & Connect Tailscale VPN
        env:
          TAILSCALE_AUTHKEY: ${{ secrets.TAILSCALE_AUTHKEY }}
        run: |
          curl -fsSL https://tailscale.com/install.sh | sh

          sudo tailscale up \
            --auth-key="$TAILSCALE_AUTHKEY" \
            --hostname="github-linux-rdp"

          # Retry loop instead of a fixed sleep — waits until Tailscale actually has an IP
          ts_ip=""
          for i in $(seq 1 15); do
            ts_ip=$(sudo tailscale ip -4 2>/dev/null || true)
            if [ -n "$ts_ip" ]; then
              break
            fi
            echo "Waiting for Tailscale IP... ($i/15)"
            sleep 2
          done

          if [ -z "$ts_ip" ]; then
            echo "ERROR: Tailscale never got an IP. Check TAILSCALE_AUTHKEY (must be reusable)."
            exit 1
          fi

          echo ""
          echo "=================================================="
          echo "  >>> UBUNTU DESKTOP SERVER IS READY! <<<"
          echo "=================================================="
          echo "  Tailscale IP : $ts_ip"
          echo "  Username     : NvDAdmin"
          echo "  Password     : (fixed test password used — see repo secret / step 2)"
          echo "  >> Open mstsc and connect to: $ts_ip"
          echo "=================================================="

      - name: 4. Keep Server Alive (6 Hours)
        run: |
          for i in $(seq 1 360); do
            sleep 60
            echo "[$i/360] Ubuntu Desktop running..."
          done
