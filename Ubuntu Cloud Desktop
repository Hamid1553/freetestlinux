Name: Ubuntu Desktop Cloud RDP

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:

      - name: 1. Enable Remote Desktop & Firewall
        run: |
          sudo apt update
          sudo apt install -y xfce4 xfce4-goodies xrdp xorgxrdp dbus-x11
          sudo adduser xrdp ssl-cert || true
          sudo systemctl enable xrdp
          sudo systemctl restart xrdp

      - name: 2. Create Admin Account
        run: |
          # Generate a random password and pass it to GITHUB_ENV
          RDP_PASSWORD=$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 16)
          echo "RDP_PASSWORD=$RDP_PASSWORD" >> $GITHUB_ENV

          # Create or update the Linux user
          sudo useradd -m -s /bin/bash NvDAdmin || true
          echo "NvDAdmin:$RDP_PASSWORD" | sudo chpasswd
          sudo usermod -aG sudo NvDAdmin
          sudo usermod -aG ssl-cert NvDAdmin

          # Configure XFCE session
          echo "xfce4-session" | sudo tee /home/NvDAdmin/.xsession
          sudo chown NvDAdmin:NvDAdmin /home/NvDAdmin/.xsession
          sudo chmod +x /home/NvDAdmin/.xsession

          # Configure xRDP startup
          sudo bash -c 'cat > /etc/xrdp/startwm.sh << "EOF"
          #!/bin/sh
          if [ -r /etc/profile ]; then
              . /etc/profile
          fi

          if [ -r "$HOME/.profile" ]; then
              . "$HOME/.profile"
          fi

          export XDG_CURRENT_DESKTOP=XFCE
          export XDG_SESSION_DESKTOP=xfce
          export XDG_CONFIG_DIRS=/etc/xdg/xdg-xfce:/etc/xdg
          export XDG_DATA_DIRS=/usr/share/xfce4:/usr/local/share:/usr/share

          exec startxfce4
          EOF'

          sudo chmod +x /etc/xrdp/startwm.sh
          sudo systemctl restart xrdp

      - name: 3. Install & Connect Tailscale VPN
        env:
          TAILSCALE_AUTHKEY: ${{ secrets.TAILSCALE_AUTHKEY }}

        run: |
          curl -fsSL https://tailscale.com/install.sh | sh

          sudo tailscale up \
            --auth-key="$TAILSCALE_AUTHKEY" \
            --hostname="github-linux-rdp"

          sleep 8

          ts_ip=$(sudo tailscale ip -4)

          echo ""
          echo "=================================================="
          echo "  >>> UBUNTU DESKTOP SERVER IS READY! <<<"
          echo "=================================================="
          echo "  Tailscale IP : $ts_ip"
          echo "  Username     : NvDAdmin"
          echo "  Password     : $RDP_PASSWORD"
          echo "  >> Open mstsc and connect to: $ts_ip"
          echo "=================================================="

      - name: 4. Keep Server Alive (6 Hours)
        run: |
          for i in $(seq 1 360); do
            sleep 60
            echo "[$i/360] Ubuntu Desktop running..."
          done
